---
import { getCollection, type CollectionEntry } from 'astro:content';
import Diagram from '../components/Diagram.astro';
import '../styles/global.css';

interface Props {
  page: CollectionEntry<'guide'>;
  headings: { depth: number; slug: string; text: string }[];
}
const { page, headings } = Astro.props;
const pages = (await getCollection('guide')).sort((a, b) => a.data.order - b.data.order);
const sections = [...new Set(pages.map((entry) => entry.data.section))];
const current = pages.findIndex((entry) => entry.id === page.id);
const previous = pages[current - 1];
const next = pages[current + 1];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = (id: string) => id === 'start' ? `${base}/` : `${base}/${id}/`;
const stale = Date.now() - new Date(`${page.data.verified}T00:00:00Z`).getTime() > 30 * 86400000;
const titleWords = page.data.title.split(' ');
const titleEmphasis = page.id === 'start' ? titleWords.splice(-3).join(' ') : '';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={page.data.description} />
    <meta name="color-scheme" content="light dark" />
    <title>{page.data.title} · AI Credits Learning Guide</title>
    <script is:inline>
      (() => {
        let preference = 'system';
        try { preference = localStorage.getItem('theme') || 'system'; } catch {}
        const dark = preference === 'dark' || (preference === 'system' && matchMedia('(prefers-color-scheme: dark)').matches);
        document.documentElement.dataset.theme = dark ? 'dark' : 'light';
        document.documentElement.dataset.preference = preference;
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#content">Skip to content</a>
    <header class="topbar">
      <a class="brand" href={`${base}/`} aria-label="AI Credits Learning Guide home">
        <svg class="brand-mark" aria-hidden="true" viewBox="0 0 16 16" width="30" height="30"><path d="M6.766 11.328c-2.063-.25-3.516-1.734-3.516-3.656 0-.781.281-1.625.75-2.188-.203-.515-.172-1.609.063-2.062.625-.078 1.468.25 1.968.703.594-.187 1.219-.281 1.985-.281.765 0 1.39.094 1.953.265.484-.437 1.344-.765 1.969-.687.218.422.25 1.515.046 2.047.5.593.766 1.39.766 2.203 0 1.922-1.453 3.375-3.547 3.64.531.344.89 1.094.89 1.954v1.625c0 .468.391.734.86.547C13.781 14.359 16 11.53 16 8.03 16 3.61 12.406 0 7.984 0 3.563 0 0 3.61 0 8.031a7.88 7.88 0 0 0 5.172 7.422c.422.156.828-.125.828-.547v-1.25c-.219.094-.5.156-.75.156-1.031 0-1.64-.562-2.078-1.609-.172-.422-.36-.672-.719-.719-.187-.015-.25-.093-.25-.187 0-.188.313-.328.625-.328.453 0 .844.281 1.25.86.313.452.64.655 1.031.655s.641-.14 1-.5c.266-.265.47-.5.657-.656"/></svg>
        Learning Guide
      </a>
      <nav class="breadcrumbs" aria-label="Breadcrumb"><span>Enterprise enablement</span><span aria-hidden="true">/</span><span>{page.data.section}</span></nav>
      <label class="theme-label"><span aria-hidden="true">◐</span><span class="sr-only">Color theme</span><select id="theme" aria-label="Color theme"><option value="system">System</option><option value="light">Light</option><option value="dark">Dark</option></select></label>
    </header>
    <div class="shell">
      <aside class="sidebar">
        <div class="edition">GUIDE CONTENTS<span>AI credit budgeting</span></div>
        <details class="chapter-nav" open>
          <summary>Explore the guide <span aria-hidden="true">⌄</span></summary>
          <nav aria-label="Guide chapters">
            {sections.map((section, index) => (
              <details class="chapter" open={section === page.data.section}>
                <summary><span class="chapter-number">{String(index + 1).padStart(2, '0')}</span>{section}<span class="chevron" aria-hidden="true">›</span></summary>
                <div class="chapter-pages">{pages.filter((entry) => entry.data.section === section).map((entry) => <a href={href(entry.id)} aria-current={entry.id === page.id ? 'page' : undefined}>{entry.data.title}</a>)}</div>
              </details>
            ))}
          </nav>
        </details>
        <div class="sidebar-note">Built for the conversation.<br />Ready for implementation.<a href={`${base}/sources/`}>Sources & release status <span aria-hidden="true">→</span></a></div>
      </aside>
      <main id="content">
        <div class="article-grid">
          <article>
            <div class="eyebrow">{page.data.section}<span class="eyebrow-line"></span></div>
            <h1>{titleWords.join(' ')}{titleEmphasis && <> <span class="title-emphasis">{titleEmphasis}</span></>}</h1>
            <p class="lede">{page.data.description}</p>
            <div class="page-meta"><span>ENTERPRISE GUIDE</span><span>Reviewed {page.data.verified}</span>{stale && <strong class="status caution">Review overdue · verify against sources</strong>}</div>
            {page.data.diagram && <section class="diagram-section" aria-label="Visual explanation">
              <div class="figure-label">VISUAL LESSON</div>
              <Diagram name={page.data.diagram} />
            </section>}
            <div class="prose"><slot /></div>
            {page.data.scenarioDiagram && <section class="diagram-section" aria-label="Scenario visual">
              <div class="figure-label">APPLY THE CONCEPT</div>
              <Diagram name={page.data.scenarioDiagram} />
            </section>}
            <section class="source-note" aria-labelledby="page-sources">
              <h2 id="page-sources">Sources & freshness</h2>
              <p>Source review: <time datetime={page.data.verified}>{page.data.verified}</time>. This independent guide is not a contract or a substitute for your billing settings. Source links are authoritative; recommendations are labeled as guide advice.</p>
              <ul>{page.data.sources.map((source) => <li><a href={source} target="_blank" rel="noopener noreferrer">{new URL(source).hostname} / {new URL(source).pathname.split('/').filter(Boolean).at(-1)?.replaceAll('-', ' ')} ↗</a></li>)}</ul>
            </section>
            <nav class="pagination" aria-label="Reading sequence">{previous ? <a href={href(previous.id)}><small>← PREVIOUS</small>{previous.data.title}</a> : <span></span>}{next && <a class="next" href={href(next.id)}><small>NEXT CHAPTER →</small>{next.data.title}</a>}</nav>
            <footer class="article-footer">AI Credits Learning Guide <span>Independent guidance. Official sources, clearly linked.</span></footer>
          </article>
          <aside class="toc" aria-label="On this page"><div>ON THIS PAGE</div>{headings.filter((h) => h.depth === 2).map((heading) => <a href={`#${heading.slug}`}>{heading.text}</a>)}<a href="#page-sources">Sources & freshness</a></aside>
        </div>
      </main>
    </div>
    <script>
      const select = document.querySelector<HTMLSelectElement>('#theme')!;
      const media = matchMedia('(prefers-color-scheme: dark)');
      const mobile = matchMedia('(max-width: 760px)');
      const navigation = document.querySelector<HTMLDetailsElement>('.chapter-nav')!;
      function syncNavigation() {
        navigation.open = !mobile.matches;
      }
      syncNavigation();
      mobile.addEventListener('change', syncNavigation);
      document.querySelectorAll<HTMLButtonElement>('[data-diagram-size]').forEach((button) => {
        button.hidden = false;
        button.addEventListener('click', () => {
          const zoomed = button.closest('figure')!.classList.toggle('diagram-zoomed');
          button.setAttribute('aria-pressed', String(zoomed));
          button.textContent = zoomed ? 'Fit figure to screen' : 'Zoom figure';
        });
      });
      select.value = document.documentElement.dataset.preference || 'system';
      function applyTheme() {
        const preference = select.value;
        const theme = preference === 'system' ? (media.matches ? 'dark' : 'light') : preference;
        document.documentElement.dataset.theme = theme;
        document.documentElement.dataset.preference = preference;
        document.querySelectorAll<HTMLAnchorElement>('[data-diagram-link]').forEach((link) => {
          const url = new URL(link.href);
          url.hash = theme;
          link.href = url.href;
        });
      }
      select.addEventListener('change', () => {
        try { localStorage.setItem('theme', select.value); } catch {}
        applyTheme();
      });
      media.addEventListener('change', applyTheme);
      applyTheme();
    </script>
  </body>
</html>
